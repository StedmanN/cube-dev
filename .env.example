# CUBE TEST-copy configuration. This checkout is local-only and must never use
# AWS credentials, AWS profiles, GovCloud endpoints, or Secrets Manager values.

# --- Authentication --------------------------------------------------------
# The application enforces local mode in code; this value documents the intent.
AUTH_MODE=local

COGNITO_CLIENT_ID=COGNITO_DISABLED_IN_LOCAL_TEST_COPY
COGNITO_CLIENT_SECRET=COGNITO_DISABLED_IN_LOCAL_TEST_COPY
COGNITO_ISSUER=http://127.0.0.1:9
COGNITO_DOMAIN=http://127.0.0.1:9
COGNITO_USER_POOL_ID=COGNITO_DISABLED_IN_LOCAL_TEST_COPY
COGNITO_FORCE_IDP=

# --- NextAuth --------------------------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://127.0.0.1:3001

# DynamoDB configuration is deliberately hard-coded in lib/dynamo.ts so shell
# AWS variables cannot redirect it. These are dummy documentation values only.
AWS_ACCESS_KEY_ID=DUMMYLOCALACCESSKEY
AWS_SECRET_ACCESS_KEY=DUMMYLOCALSECRETKEY
AWS_REGION=local
AWS_EC2_METADATA_DISABLED=true
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
