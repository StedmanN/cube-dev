{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // globals.css is excluded because Biome's CSS parser does not yet understand
  // Tailwind v4 at-rules (@custom-variant, @theme inline, @apply) and reports
  // them as parse errors rather than lint findings.
  "files": { "includes": ["**", "!.next", "!node_modules", "!app/globals.css"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "none" }
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  }
}
